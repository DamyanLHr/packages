{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "vite.config.ts",
    "src/site.ts",
    "src/catalog.ts",
    "src/pages-list.ts",
    "src/docs-pages.ts",
    "src/anchor.ts",
    "src/status.ts",
    "src/search/match.ts",
    "build/**/*.ts",
    "src/**/*.test.ts"
  ]
}
